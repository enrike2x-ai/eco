<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        hostingModel="InProcess" corre la app dentro del proceso de IIS (w3wp.exe).
        Las variables de entorno (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD,
        ECONODAT_API_KEY) se configuran en el Application Pool de IIS, NO aquí,
        para que no queden en texto plano dentro de este archivo.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\EconodatMcpServer.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess" />
    </system.webServer>
  </location>
</configuration>
